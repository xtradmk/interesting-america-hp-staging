<section class="story-section subpage-home-section subpage-home-section--contact-entry" id="contact-form">
  <div class="wrap-wide">
    <div class="contact-funnel fade">
      <form class="contact-funnel__form" name="event-inquiry" method="POST" action="{{ integrations.contactFormEndpoint }}" data-contact-request>
        <input type="hidden" name="success_path" value="{{ '/thank-you/' | url }}" data-contact-return="{{ '/contact/' | url }}">
        <p class="form-honeypot" aria-hidden="true"><label>Do not fill this out: <input name="company_website"></label></p>

        <section class="contact-funnel__section">
          <div class="contact-funnel__step-header">
            <div>
              <h2 class="contact-funnel__step-title">Send your request</h2>
              <p class="contact-funnel__step-subtitle">Start with your contact information and event. You can add details after sending your request.</p>
            </div>
          </div>
          <div class="contact-funnel__fields">
            <label>
              <span>Full Name*</span>
              <input type="text" name="full_name" placeholder="Jane Doe" required>
            </label>
            <label>
              <span>Company*</span>
              <input type="text" name="company" placeholder="Agency, federation, brand" required>
            </label>
            <label>
              <span>Work Email*</span>
              <input type="email" name="email" placeholder="name@company.com" required>
            </label>
            <label>
              <span>Event*</span>
              <select name="event" required>
                <option value="" selected disabled>Select event</option>
                <option>Super Bowl LXI 2027</option>
                <option>UCL Final Madrid 2027</option>
                <option>Women's World Cup Brazil 2027</option>
                <option>LA28</option>
                <option>UEFA EURO 2028</option>
                <option>French Alps 2030</option>
                <option>FIFA World Cup 2030</option>
                <option>Other</option>
              </select>
            </label>
            <div class="contact-funnel__field--full contact-funnel__toggle contact-funnel__toggle--legal">
              <input id="accept-legal" type="checkbox" name="accept_legal" required>
              <label for="accept-legal">
                <span>I accept the <button type="button" class="contact-funnel__legal-link" data-open-legal="terms">Terms and Conditions</button> and <button type="button" class="contact-funnel__legal-link" data-open-legal="privacy">Privacy Policy</button>.*</span>
              </label>
            </div>
          </div>
        </section>

        <div class="contact-funnel__actions contact-funnel__actions--request">
          <div class="contact-funnel__trust" aria-label="SSL secured submission">
            <svg viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true">
              <path d="M12 2a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-1V7a5 5 0 0 0-5-5Zm-3 8V7a3 3 0 0 1 6 0v3H9Zm3 3a2 2 0 0 1 1 3.732V19h-2v-2.268A2 2 0 0 1 12 13Z" fill="currentColor"></path>
            </svg>
            <span>SSL secured submission</span>
          </div>
          <button type="submit" class="contact-funnel__next contact-funnel__next--submit">Send request</button>
        </div>
      </form>

      <form class="contact-funnel__form" name="event-inquiry-details" method="POST" action="{{ integrations.contactUpdateEndpoint }}" data-contact-details="{{ '/thank-you/' | url }}" hidden>
        <input type="hidden" name="inquiry_id">
        <p class="form-honeypot" aria-hidden="true"><label>Do not fill this out: <input name="company_website"></label></p>
        <div>
          <h2 class="contact-funnel__step-title" tabindex="-1" data-contact-confirmation>Request received</h2>
          <p class="contact-funnel__step-subtitle">You can share more details about your event below. These details are optional.</p>
        </div>

        <section class="contact-funnel__section">
          <div class="contact-funnel__step-header">
            <div>
              <h2 class="contact-funnel__step-title">Where and when?</h2>
              <p class="contact-funnel__step-subtitle">Help us narrow down the right options.</p>
            </div>
          </div>
          <div class="contact-funnel__fields">
            <label>
              <span>Host City / Area</span>
              <input type="text" name="city_area" placeholder="e.g. Los Angeles">
            </label>
            <label>
              <span>Phone / WhatsApp</span>
              <input type="text" name="phone" placeholder="+1 310 555 0124">
            </label>
            <label>
              <span>Check-in</span>
              <input type="date" name="check_in">
            </label>
            <label>
              <span>Check-out</span>
              <input type="date" name="check_out">
            </label>
            <label class="contact-funnel__toggle contact-funnel__toggle--solo">
              <input type="checkbox" name="varying_dates" data-varying-dates-toggle>
              <span>Check-in and check-out dates vary across rooms</span>
            </label>
            <p class="contact-funnel__hint" data-varying-dates-note hidden>Please enter the earliest check-in and latest check-out dates above. Add room-specific dates under Request Details.</p>
          </div>
        </section>

        <section class="contact-funnel__section">
          <div class="contact-funnel__step-header">
            <div>
              <h2 class="contact-funnel__step-title">How many rooms?</h2>
              <p class="contact-funnel__step-subtitle">A rough count and budget are enough for now.</p>
            </div>
          </div>
          <div class="contact-funnel__fields">
            <label>
              <span>Total Rooms</span>
              <input type="number" name="rooms_total" min="1" placeholder="e.g. 40">
            </label>
            <label>
              <span>Budget per Room / Night (USD)</span>
              <input type="text" name="budget" placeholder="e.g. 450">
            </label>
            <label>
              <span>Main Guest Mix</span>
              <select name="guest_mix">
                <option value="" selected disabled>Select mix</option>
                <option>Sponsor guests + staff</option>
                <option>Media crews + journalists</option>
                <option>Federation + families</option>
                <option>Agency travelers</option>
                <option>Mixed</option>
              </select>
            </label>
            <label>
              <span>Required Services</span>
              <select name="services_scope">
                <option value="" selected disabled>Select scope</option>
                <option>Accommodation only</option>
                <option>Accommodation + transfers</option>
                <option>Accommodation + guest hospitality</option>
                <option>Full package</option>
              </select>
            </label>
          </div>
        </section>

        <section class="contact-funnel__section">
          <div class="contact-funnel__step-header">
            <div>
              <h2 class="contact-funnel__step-title">Anything else?</h2>
              <p class="contact-funnel__step-subtitle">Add details that help us prepare the right proposal.</p>
            </div>
          </div>
          <div class="contact-funnel__fields">
            <label class="contact-funnel__field--full">
              <span>Request Details</span>
              <textarea name="request_details" rows="6" placeholder="Room split, level, location priorities, constraints, varying date details"></textarea>
            </label>
            <label>
              <span>Decision Deadline</span>
              <input type="text" name="decision_deadline" placeholder="e.g. Friday 16:00 CET">
            </label>
          </div>
        </section>

        <div class="contact-funnel__actions">
          <button type="submit" class="contact-funnel__next contact-funnel__next--submit">Send additional details</button>
          <p class="contact-funnel__note" role="status" data-contact-details-status></p>
        </div>
      </form>

    </div>
  </div>
</section>

<div class="legal-overlay" data-legal-overlay="terms" hidden>
  <div class="legal-overlay__backdrop" data-close-legal></div>
  <div class="legal-overlay__dialog" role="dialog" aria-modal="true" aria-labelledby="legal-overlay-title-terms">
    <div class="legal-overlay__header">
      <h2 id="legal-overlay-title-terms">Terms &amp; Conditions</h2>
      <button type="button" class="legal-overlay__close" data-close-legal aria-label="Close Terms and Conditions overlay">Close</button>
    </div>
    <div class="legal-overlay__body">
      {% include "modules/legal-terms-flow.njk" %}
    </div>
  </div>
</div>

<div class="legal-overlay" data-legal-overlay="privacy" hidden>
  <div class="legal-overlay__backdrop" data-close-legal></div>
  <div class="legal-overlay__dialog" role="dialog" aria-modal="true" aria-labelledby="legal-overlay-title-privacy">
    <div class="legal-overlay__header">
      <h2 id="legal-overlay-title-privacy">Privacy Policy</h2>
      <button type="button" class="legal-overlay__close" data-close-legal aria-label="Close Privacy Policy overlay">Close</button>
    </div>
    <div class="legal-overlay__body">
      {% include "modules/legal-privacy-flow.njk" %}
    </div>
  </div>
</div>
