<footer class="site-footer">
  <div class="container footer-shell">
    <div class="footer-content">
      <div class="footer-signup-row">
        <p class="footer-copy">Sign up now and stay updated about accommodation, transfers, and hospitality at the major global sports events:</p>

        <form class="footer-newsletter" data-newsletter-form method="POST" action="{{ integrations.newsletterFormEndpoint }}" aria-label="Newsletter subscription form">
          <input type="hidden" name="success_path" value="{{ '/thank-you/' | url }}">
          <p class="form-honeypot" aria-hidden="true"><label>Do not fill this out: <input name="company_website"></label></p>
          <label class="footer-newsletter__field" for="footer-newsletter-email">
            <span class="sr-only">Email address</span>
            <input id="footer-newsletter-email" type="email" name="email" autocomplete="email" placeholder="Email address" required>
          </label>
          <button class="footer-newsletter__button" type="submit">Subscribe</button>
        </form>
      </div>
    </div>

    <div class="footer-offices" aria-label="Offices and inquiries">
      <address><strong>Los Angeles</strong><br>1427 North Wilcox Avenue, 2nd floor<br>Hollywood, CA 90028</address>
      <address><strong>Barcelona</strong><br>Av. Diagonal 640, 6.ª planta<br>08017 Barcelona, Spain</address>
      <address><strong>Rio de Janeiro</strong><br>Rua Cons. Saraiva, 28 - 6º<br>Rio de Janeiro, Brazil</address>
      <div>
        <strong>Inquiries</strong><br>
        General: <a href="mailto:sports@interesting.global">sports@interesting.global</a><br>
        USA: <a href="mailto:america@interesting.global">america@interesting.global</a>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-bottom__main">
        <div class="footer-brand">
          <img src="{{ '/images/uploads/interesting-sports-black-.png' | url }}" alt="{{ site.name }}" class="footer-logo__img">
        </div>

        <nav class="footer-nav" aria-label="Footer navigation">
          <ul>
            <li><a href="{{ '/' | url }}">Home</a></li>
            {%- for item in site.nav -%}
              <li><a href="{{ item.url | url }}">{{ item.text }}</a></li>
            {%- endfor -%}
            <li><a href="{{ '/t-c/' | url }}">Terms &amp; Conditions</a></li>
            <li><a href="{{ '/privacy-policy/' | url }}">Privacy Policy</a></li>
          </ul>
        </nav>
      </div>

      <div class="footer-legal">
        <p>© 2010–2026 INTERESTING AMERICA LLC. All rights reserved.</p>
        <p>Member of ISTAA · <a href="https://interesting.global/">interesting.global</a></p>
      </div>
    </div>
  </div>
</footer>
